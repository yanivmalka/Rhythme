<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: the hold pad with its progress ring three quarters full (gold head),
     and the guide's square wave (note, rest, note) on the pad. Kept inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Ring track -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.99,26"
        android:strokeColor="#26FFFFFF"
        android:strokeWidth="5" />
    <!-- Ring fill -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 26,54"
        android:strokeColor="#7FD4FF"
        android:strokeLineCap="round"
        android:strokeWidth="5" />
    <!-- Gold head of the fill -->
    <path
        android:fillColor="#FFC94D"
        android:pathData="M26,54m-4,0a4,4 0 1,0 8,0a4,4 0 1,0 -8,0" />
    <!-- Pad -->
    <path
        android:fillColor="#3380E6"
        android:pathData="M54,54m-20,0a20,20 0 1,0 40,0a20,20 0 1,0 -40,0" />
    <!-- Square wave -->
    <path
        android:pathData="M41.5,59h4v-10h7v10h4v-10h7v10h3"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.8" />
</vector>
